{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null && $userId === auth.uid"
      }
    },
    "usagePresence": {
      ".read": "auth != null",
      "$sessionId": {
        ".write": "auth != null"
      }
    },
    "loginPresence": {
      ".read": "auth != null",
      "$sessionId": {
        ".write": "auth != null"
      }
    }
  }
}
