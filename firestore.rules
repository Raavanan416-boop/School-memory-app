rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can read/write
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Admin detection — checks role field in admin's user doc
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Owner or admin can write anything
      allow write: if isOwner(userId) || isAdmin();
      // Any authenticated user can update points (for birthday gift transfers)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']);

      // Subcollections (savedPosts, taggedPosts)
      match /savedPosts/{postId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId) || isAdmin();
      }
      match /taggedPosts/{postId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // Anyone can tag someone
      }
    }

    // Leaderboard — readable by all, writable by any authenticated user (points sync)
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Presence — online/offline status, readable by all, writable by any authenticated user
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated()
          && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Polls
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Time Capsules
    match /timeCapsules/{capsuleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      // Future Messages
      match /messages/{messageId} {
        // Anyone can create a message for a time capsule
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        
        // You can read your own messages.
        // Capsule creator can read ALL messages, ONLY IF the capsule is unlocked.
        allow read: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/timeCapsules/$(capsuleId)).data.authorId == request.auth.uid &&
            get(/databases/$(database)/documents/timeCapsules/$(capsuleId)).data.isUnlocked == true
          )
        );
        
        // You can delete your own messages. Creator can delete any message.
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/timeCapsules/$(capsuleId)).data.authorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Diary entries
    match /diary/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      // Replies subcollection
      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Continuations subcollection
      match /continuations/{contId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // Notifications — user can manage their own notifications
    match /notifications/{notifId} {
      // User can read their own notifications or admin can read all
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      // Any authenticated user can create notifications (for others)
      allow create: if isAuthenticated();
      // User can update their own (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // User can delete their own
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Birthday wishes — private: only sender or receiver can read (Legacy)
    match /birthdays/{wishId} {
      allow read: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid
            || resource.data.targetUserId == request.auth.uid
            || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
    }

    // New Birthday Conversation System (Active Birthday Only)
    match /birthdayConversations/{birthdayUserId}/wishes/{wishId} {
      allow read: if isAuthenticated() && (birthdayUserId == request.auth.uid || resource.data.senderId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid && wishId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (birthdayUserId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'reactions']))
        || isAdmin()
      );
      allow delete: if isAuthenticated() && (birthdayUserId == request.auth.uid || isAdmin());

      match /replies/{replyId} {
        allow read: if isAuthenticated() && (
          birthdayUserId == request.auth.uid || 
          get(/databases/$(database)/documents/birthdayConversations/$(birthdayUserId)/wishes/$(wishId)).data.senderId == request.auth.uid || 
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          birthdayUserId == request.auth.uid || 
          get(/databases/$(database)/documents/birthdayConversations/$(birthdayUserId)/wishes/$(wishId)).data.senderId == request.auth.uid
        );
        allow update: if isAuthenticated() && (
          birthdayUserId == request.auth.uid || 
          get(/databases/$(database)/documents/birthdayConversations/$(birthdayUserId)/wishes/$(wishId)).data.senderId == request.auth.uid
        ) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isAuthenticated() && (birthdayUserId == request.auth.uid || isAdmin());
      }
    }

    // Birthday Wish History (Archived Birthdays)
    match /birthdayWishHistory/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
      
      match /wishes/{wishId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
        
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated();
          allow update: if isAuthenticated();
          allow delete: if isAdmin();
        }
      }
    }

    // Birthday points (self-claim + friend gifts)
    match /birthdayPoints/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // Points transaction history
    match /pointsHistory/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Games (scores, votes, etc.)
    match /games/{gameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // Slam Books (New system)
    match /slambooks/{bookId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.ownerId == request.auth.uid || 
        resource.data.visibility == 'allFriends' ||
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'friends' ||
        resource.data.visibility == 'all' ||
        (resource.data.visibility == 'closeFriends' && request.auth.uid in resource.data.selectedFriends) ||
        (resource.data.visibility == 'close' && request.auth.uid in resource.data.selectedFriends)
      );
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Slam Book Responses
    match /slambookResponses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() 
        && (resource.data.authorId == request.auth.uid || resource.data.targetUserId == request.auth.uid);
      allow delete: if isAuthenticated() 
        && (resource.data.authorId == request.auth.uid || resource.data.targetUserId == request.auth.uid || isAdmin());
    }

    // Badge suggestions
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.suggestedBy == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.targetUserId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.targetUserId == request.auth.uid || resource.data.suggestedBy == request.auth.uid || isAdmin());
    }

    // Calls (WebRTC signaling)
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // Advanced Reset Logs
    match /resetLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Feedback
    match /feedback/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Login History
    match /loginHistory/{userId} {
      allow read, write: if isAdmin();
      
      match /sessions/{sessionId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // Settings (Features)
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // App Usage History
    match /appUsage/{sessionId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // System Settings (Launch control, etc.)
    match /systemSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Story Books (Self Stories)
    match /stories/{storyId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.authorId == request.auth.uid || 
        resource.data.visibility == 'allFriends' ||
        resource.data.visibility == 'public' ||
        resource.data.visibility == 'friends' ||
        resource.data.visibility == 'all' ||
        (resource.data.visibility == 'closeFriends' && request.auth.uid in resource.data.selectedFriends) ||
        (resource.data.visibility == 'close_friends' && request.auth.uid in resource.data.selectedFriends)
      );
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated(); // For incrementing views/likes/comments
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid));
        
        match /replies/{replyId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update: if isAuthenticated();
          allow delete: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid));
        }

        match /reactions/{userId} {
          allow read: if isAuthenticated();
          allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
        }
      }

      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && request.auth.uid == userId;
      }
      
      match /views/{userId} {
        allow read: if isAuthenticated() && get(/databases/$(database)/documents/stories/$(storyId)).data.authorId == request.auth.uid;
        allow create, update: if isAuthenticated() && request.auth.uid == userId;
      }
    }
    match /storyLikes/{likeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    match /storyViews/{viewId} {
      allow read, write: if isAuthenticated();
    }
  }
}
