rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can read/write
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Admin detection — checks role field in admin's user doc
    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Owner or admin can write anything
      allow write: if isOwner(userId) || isAdmin();
      // Any authenticated user can update points (for birthday gift transfers)
      allow update: if isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points']);
    }

    // Leaderboard — readable by all, writable by any authenticated user (points sync)
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Presence — online/offline status, readable by all, writable by any authenticated user
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated()
          && request.resource.data.senderId == request.auth.uid;
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated()
          && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Polls
    match /polls/{pollId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // Time Capsules
    match /timeCapsules/{capsuleId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      // Future Messages
      match /messages/{messageId} {
        // Anyone can create a message for a time capsule
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        
        // You can read your own messages.
        // Capsule creator can read ALL messages, ONLY IF the capsule is unlocked.
        allow read: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          (
            get(/databases/$(database)/documents/timeCapsules/$(capsuleId)).data.authorId == request.auth.uid &&
            get(/databases/$(database)/documents/timeCapsules/$(capsuleId)).data.isUnlocked == true
          )
        );
        
        // You can delete your own messages. Creator can delete any message.
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/timeCapsules/$(capsuleId)).data.authorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Diary entries
    match /diary/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid || isAdmin());

      // Replies subcollection
      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }

      // Continuations subcollection
      match /continuations/{contId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }

    // Notifications — user can manage their own notifications
    match /notifications/{notifId} {
      // User can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Any authenticated user can create notifications (for others)
      allow create: if isAuthenticated();
      // User can update their own (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // User can delete their own
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Birthday wishes — private: only sender or receiver can read
    match /birthdays/{wishId} {
      allow read: if isAuthenticated()
        && (resource.data.authorId == request.auth.uid
            || resource.data.targetUserId == request.auth.uid);
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid;
    }

    // Birthday points (self-claim + friend gifts)
    match /birthdayPoints/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // Points transaction history
    match /pointsHistory/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Games (scores, votes, etc.)
    match /games/{gameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // Slam Books (New system)
    match /slambooks/{bookId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // Slam Book Responses
    match /slambookResponses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() 
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() 
        && (resource.data.authorId == request.auth.uid || resource.data.targetUserId == request.auth.uid);
      allow delete: if isAuthenticated() 
        && (resource.data.authorId == request.auth.uid || resource.data.targetUserId == request.auth.uid || isAdmin());
    }

    // Badge suggestions
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.suggestedBy == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.targetUserId == request.auth.uid;
      allow delete: if isAuthenticated()
        && (resource.data.targetUserId == request.auth.uid || resource.data.suggestedBy == request.auth.uid);
    }

    // Calls (WebRTC signaling)
    match /calls/{callId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
      }
    }
  }
}
